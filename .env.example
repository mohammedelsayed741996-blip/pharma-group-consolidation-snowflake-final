# Snowflake connection for orchestration/run_pipeline.py and the opt-in integration tests.
# Copy to .env (git-ignored) and fill in. Use EITHER a private key (recommended) OR a password.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Path to a PKCS#8 private key, e.g. ~/.ssh/snowflake_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Only used when no private key path is set
SNOWFLAKE_PASSWORD=

# Optional (defaults shown). The admin role is used by the "setup" step only.
SNOWFLAKE_ROLE=FIN_ENGINEER
SNOWFLAKE_ADMIN_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=WH_FIN_XS
SNOWFLAKE_DATABASE=HELIX_FIN

# Set to 1 to run the 19 Snowflake integration tests: pytest -m snowflake
HELIX_RUN_SNOWFLAKE_TESTS=0
